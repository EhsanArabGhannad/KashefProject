@model KashefProject.Data.StoreOrder
@{ ViewData["Title"] = "Order status"; }
<main class="commerce-shell">
    <div class="commerce-heading"><span>YOUR ORDER</span><h1>@(Model.Status switch { KashefProject.Data.OrderStatus.Paid => "Payment received", KashefProject.Data.OrderStatus.Refunded => "Payment refunded", KashefProject.Data.OrderStatus.Cancelled => "Order cancelled", _ => "Payment pending" })<span>.</span></h1><p class="order-reference">Reference @Model.Reference</p></div>
    <span class="order-status @(Model.Status == KashefProject.Data.OrderStatus.Paid ? "order-status--paid" : Model.Status == KashefProject.Data.OrderStatus.Refunded ? "order-status--refunded" : "")">@(Model.Status switch { KashefProject.Data.OrderStatus.Paid => "Paid · order confirmed", KashefProject.Data.OrderStatus.Refunded => "Fully refunded", KashefProject.Data.OrderStatus.Cancelled => "Cancelled · not paid", _ => "Pending payment · not confirmed" })</span>
    @if (TempData["PaymentError"] is string paymentError) { <p class="commerce-notice commerce-error" role="alert" style="margin-top:24px">@paymentError</p> }
    @if (TempData["PaymentNotice"] is string paymentNotice) { <p class="commerce-notice" role="status" style="margin-top:24px">@paymentNotice</p> }
    @if (Context.Request.Query["payment"] == "cancelled" && Model.Status == KashefProject.Data.OrderStatus.PendingPayment) { <p class="commerce-notice" role="status" style="margin-top:24px">You returned from payment. Your order is saved. If you completed payment, check its status before trying again.</p> }
    <div class="commerce-grid" style="margin-top:32px">
        <section>
            @if (Model.Status == KashefProject.Data.OrderStatus.Paid) { <h2>Thank you for your order.</h2><p style="line-height:1.8;margin:20px 0">Your payment was verified securely through Stripe. We'll use the contact details on this order for fulfillment updates.</p> }
            else if (Model.Status == KashefProject.Data.OrderStatus.Refunded) { <h2>Your full refund is confirmed.</h2><p style="line-height:1.8;margin:20px 0">The funds are returning to the original payment method. Your bank may take several business days to show the refund.</p> }
            else if (Model.Status == KashefProject.Data.OrderStatus.Cancelled) { <h2>This order was cancelled.</h2><p style="line-height:1.8;margin:20px 0">No fulfillment will begin for this order.</p> }
            else { <h2>No payment has been received yet.</h2><p style="line-height:1.8;margin:20px 0">Your order details are saved, but production will not begin until payment is verified.</p>
                @if ((bool?)ViewData["PaymentsEnabled"] == true) {
                    <div class="order-actions">
                        @if (!string.IsNullOrWhiteSpace(Model.StripeCheckoutSessionId)) {
                            <form method="post" action="/checkout/status/@Model.Reference" data-submit-once>@Html.AntiForgeryToken()<button class="button button-dark" type="submit" data-pending-label="Checking payment…">Check payment status <span>↻</span></button></form>
                        }
                        <form method="post" action="/checkout/pay/@Model.Reference" data-submit-once>@Html.AntiForgeryToken()<button class="button button-dark" type="submit" data-pending-label="Opening secure payment…">Pay securely with Stripe <span>→</span></button></form>
                    </div>
                }
            }
            <p>This order is saved in your account.</p><a class="button button-dark" style="margin-top:28px" href="/account/">View order history <span>→</span></a>@if (Model.Status is KashefProject.Data.OrderStatus.Paid or KashefProject.Data.OrderStatus.Refunded) { <a class="button" href="/account/orders/@Model.Reference/invoice">Printable invoice <span>↗</span></a> }
        </section>
        <aside class="commerce-summary"><span class="commerce-eyebrow">ORDER · USD</span>
            @foreach (var line in Model.Lines) { <div class="commerce-mini-line"><span>@line.ProductName × @line.Quantity</span><strong>@StoreMoney.Format(line.UnitPriceCents * line.Quantity)</strong></div> }
            <div class="commerce-mini-line"><span>Item subtotal</span><strong>@StoreMoney.Format(Model.SubtotalCents)</strong></div>
            <div class="commerce-mini-line"><span>Shipping</span><strong>@(Model.ShippingCents == 0 ? "Free" : Model.ShippingCents is null ? "Pending" : StoreMoney.Format(Model.ShippingCents.Value))</strong></div>
            @if (Model.Status is KashefProject.Data.OrderStatus.Paid or KashefProject.Data.OrderStatus.Refunded) { <div class="commerce-mini-line"><span>Tax</span><strong>@StoreMoney.Format(Model.TaxCents ?? 0)</strong></div> }
            <div class="summary-total"><span>@(Model.Status == KashefProject.Data.OrderStatus.Refunded ? "Total refunded" : Model.Status == KashefProject.Data.OrderStatus.Paid ? "Total paid" : "Total before tax")</span><strong>@StoreMoney.Format(Model.Status == KashefProject.Data.OrderStatus.Refunded ? Model.RefundedCents ?? Model.PaymentReceivedCents ?? 0 : Model.Status == KashefProject.Data.OrderStatus.Paid ? Model.PaymentReceivedCents ?? Model.SubtotalCents : Model.SubtotalCents + (Model.ShippingCents ?? 0))</strong></div><p>@(Model.Status == KashefProject.Data.OrderStatus.Refunded ? $"Refunded {Model.RefundedUtc:MMMM d, yyyy}." : Model.Status == KashefProject.Data.OrderStatus.Paid ? $"Paid {Model.PaidUtc:MMMM d, yyyy}." : "Applicable tax is finalized securely at payment when tax collection is enabled.")</p>
        </aside>
    </div>
</main>
