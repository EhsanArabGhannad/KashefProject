@model KashefProject.Data.StoreOrder
@{ ViewData["Title"] = "Order status"; }
<main class="commerce-shell">
    <div class="commerce-heading"><span>YOUR ORDER</span><h1>@(Model.Status switch { KashefProject.Data.OrderStatus.Paid => "Payment received", KashefProject.Data.OrderStatus.Cancelled => "Order cancelled", _ => "Payment pending" })<span>.</span></h1><p class="order-reference">Reference @Model.Reference</p></div>
    <span class="order-status @(Model.Status == KashefProject.Data.OrderStatus.Paid ? "order-status--paid" : "")">@(Model.Status switch { KashefProject.Data.OrderStatus.Paid => "Paid · order confirmed", KashefProject.Data.OrderStatus.Cancelled => "Cancelled · not paid", _ => "Pending payment · not confirmed" })</span>
    @if (TempData["PaymentError"] is string paymentError) { <p class="commerce-notice commerce-error" style="margin-top:24px">@paymentError</p> }
    @if (Context.Request.Query["payment"] == "cancelled" && Model.Status == KashefProject.Data.OrderStatus.PendingPayment) { <p class="commerce-notice" style="margin-top:24px">Payment was cancelled. Your order is saved and you can try again when you're ready.</p> }
    <div class="commerce-grid" style="margin-top:32px">
        <section>
            @if (Model.Status == KashefProject.Data.OrderStatus.Paid) { <h2>Thank you for your order.</h2><p style="line-height:1.8;margin:20px 0">Your payment was verified securely through Stripe. We'll use the contact details on this order for fulfillment updates.</p> }
            else if (Model.Status == KashefProject.Data.OrderStatus.Cancelled) { <h2>This order was cancelled.</h2><p style="line-height:1.8;margin:20px 0">No fulfillment will begin for this order.</p> }
            else { <h2>No payment has been received yet.</h2><p style="line-height:1.8;margin:20px 0">Your order details are saved, but production will not begin until payment is verified.</p>
                @if ((bool?)ViewData["PaymentsEnabled"] == true) { <form method="post" action="/checkout/pay/@Model.Reference">@Html.AntiForgeryToken()<button class="button button-dark" type="submit">Pay securely with Stripe <span>→</span></button></form> }
            }
            <p>This order is saved in your account.</p><a class="button button-dark" style="margin-top:28px" href="/account/">View order history <span>→</span></a>@if (Model.Status == KashefProject.Data.OrderStatus.Paid) { <a class="button" href="/account/orders/@Model.Reference/invoice">Printable invoice <span>↗</span></a> }
        </section>
        <aside class="commerce-summary"><span class="commerce-eyebrow">ORDER · USD</span>
            @foreach (var line in Model.Lines) { <div class="commerce-mini-line"><span>@line.ProductName × @line.Quantity</span><strong>@StoreMoney.Format(line.UnitPriceCents * line.Quantity)</strong></div> }
            <div class="commerce-mini-line"><span>Item subtotal</span><strong>@StoreMoney.Format(Model.SubtotalCents)</strong></div>
            <div class="commerce-mini-line"><span>Shipping</span><strong>@(Model.ShippingCents == 0 ? "Free" : Model.ShippingCents is null ? "Pending" : StoreMoney.Format(Model.ShippingCents.Value))</strong></div>
            @if (Model.Status == KashefProject.Data.OrderStatus.Paid) { <div class="commerce-mini-line"><span>Tax</span><strong>@StoreMoney.Format(Model.TaxCents ?? 0)</strong></div> }
            <div class="summary-total"><span>@(Model.Status == KashefProject.Data.OrderStatus.Paid ? "Total paid" : "Total before tax")</span><strong>@StoreMoney.Format(Model.Status == KashefProject.Data.OrderStatus.Paid ? Model.PaymentReceivedCents ?? Model.SubtotalCents : Model.SubtotalCents + (Model.ShippingCents ?? 0))</strong></div><p>@(Model.Status == KashefProject.Data.OrderStatus.Paid ? $"Paid {Model.PaidUtc:MMMM d, yyyy}." : "Applicable tax is finalized securely at payment when tax collection is enabled.")</p>
        </aside>
    </div>
</main>
