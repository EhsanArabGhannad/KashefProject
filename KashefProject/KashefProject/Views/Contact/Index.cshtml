@model ContactInquiryViewModel
@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Contact Craftisma about custom dimensional wall art, finish options, sizing, and made-to-order panels.";
}

<main>
    <section class="contact-page">
        <div class="contact-intro reveal">
            <span class="eyebrow eyebrow--light"><i></i> Custom orders & questions</span>
            <h1>Let's make<br /><em>something yours.</em></h1>
            <p>Tell us what you have in mind—an existing piece in a new color, a different size, or a completely original idea.</p>
            <div class="contact-notes">
                <div><span>01</span><p>Share your idea and preferred size.</p></div>
                <div><span>02</span><p>We confirm the design, color, and price.</p></div>
                <div><span>03</span><p>Your piece is printed, finished, and shipped.</p></div>
            </div>
        </div>
        <form class="contact-form reveal" method="post" action="/contact" novalidate>
            @Html.AntiForgeryToken()
            <div class="form-heading"><span>START A CONVERSATION</span><b>Usually replies within 1–2 business days.</b></div>
            <div asp-validation-summary="ModelOnly" class="contact-validation" role="alert"></div>
            <label>
                <span>Your name</span>
                <input asp-for="Name" autocomplete="name" placeholder="Jane Smith" />
                <small asp-validation-for="Name"></small>
            </label>
            <label>
                <span>Email address</span>
                <input asp-for="Email" autocomplete="email" placeholder="jane@example.com" />
                <small asp-validation-for="Email"></small>
            </label>
            <label>
                <span>What are you interested in?</span>
                <select asp-for="Interest">
                    @foreach (var interest in ContactInquiryViewModel.Interests) { <option value="@interest">@interest</option> }
                </select>
                <small asp-validation-for="Interest"></small>
            </label>
            <label>
                <span>Tell us about your idea</span>
                <textarea asp-for="Message" rows="6" placeholder="A few details about the piece, size, color, or space..."></textarea>
                <small asp-validation-for="Message"></small>
            </label>
            <div class="contact-honeypot" aria-hidden="true"><label>Website<input asp-for="Website" tabindex="-1" autocomplete="off" /></label></div>
            <button class="button button-dark" type="submit">Send inquiry <span>→</span></button>
            <small>By sending this form, you agree that Craftisma may use these details to reply to your inquiry.</small>
        </form>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
