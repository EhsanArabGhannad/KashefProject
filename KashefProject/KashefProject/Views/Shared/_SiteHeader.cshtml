<header class="site-header">
    <a class="brand" href="/" aria-label="Craftisma, home">
        <span class="brand-mark">C</span>
        <span>Craftisma</span>
    </a>
    <nav class="nav-links" id="main-navigation" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/gallery/">Gallery</a>
        <a href="/shop/">Shop</a>
        <a href="/contact/">Contact</a>
    </nav>
    <div class="header-actions">
        <button class="menu-button" type="button" data-nav-toggle aria-controls="main-navigation" aria-expanded="false">
            <span></span><span></span><span></span><b>Menu</b>
        </button>
        <a class="account-button" href="@(User.Identity?.IsAuthenticated == true ? "/account/" : "/account/login")">@(User.Identity?.IsAuthenticated == true ? "Account" : "Sign in")</a>
        <a class="cart-button" href="/cart/" aria-label="Open shopping bag">
            <span>Bag</span>
            <b>@await Component.InvokeAsync("CartCount")</b>
        </a>
    </div>
</header>
