<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f1ea" />
    <meta name="description" content="کرافتیسما؛ دکور و هدیه‌های خاص ساخته‌شده با چاپ سه‌بعدی" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="کرافتیسما | اشیایی که شبیه هیچ‌کس نیستند" />
    <meta property="og:description" content="دکور و هدیه‌های متفاوت که با چاپ سه‌بعدی، لایه‌به‌لایه ساخته می‌شوند." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="کرافتیسما | اشیایی که شبیه هیچ‌کس نیستند" />
    <meta name="twitter:description" content="دکور و هدیه‌های خاص ساخته‌شده با چاپ سه‌بعدی" />
    <title>@ViewData["Title"] | کرافتیسما</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
