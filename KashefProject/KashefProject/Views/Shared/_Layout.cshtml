<!DOCTYPE html>
<html lang="en-US" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f1ea" />
    <meta name="description" content="Craftisma creates distinctive 3D-printed decor and gifts, made one layer at a time." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Craftisma | Objects unlike anyone else's" />
    <meta property="og:description" content="Distinctive 3D-printed decor and gifts, made one layer at a time." />
    <meta property="og:image" content="https://craftisma-demo.ehsanarabghannad.chatgpt.site/images/og.png" />
    <meta property="og:image:alt" content="Craftisma — Objects unlike anyone else's" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Craftisma | Objects unlike anyone else's" />
    <meta name="twitter:description" content="Distinctive 3D-printed decor and gifts, made one layer at a time." />
    <meta name="twitter:image" content="https://craftisma-demo.ehsanarabghannad.chatgpt.site/images/og.png" />
    <title>@ViewData["Title"] | Craftisma</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
