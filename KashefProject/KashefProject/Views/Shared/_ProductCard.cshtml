@model Product

<article class="product-card @Model.CardClass reveal">
    <div class="product-visual">
        <a class="product-image-link" href="/shop/@Model.Slug/" aria-label="View @Model.Name">
            <span class="product-badge">@Model.Badge</span>
            <img src="@Model.ImagePath" alt="@Model.ImageAlt" loading="lazy" />
            <span class="product-view">View piece ↗</span>
        </a>
        @if (Model.PriceCents > 0)
        {
            <form method="post" action="/cart/add" data-submit-once>@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id" /><button class="quick-add" type="submit" aria-label="Add @Model.Name to bag" data-pending-label="…">＋</button></form>
        }
    </div>
    <a class="product-info" href="/shop/@Model.Slug/" aria-label="View @Model.Name details">
        <div><h3>@Model.Name</h3><p>@Model.ShortDescription</p></div>
        <strong>@Model.Price</strong>
    </a>
</article>
