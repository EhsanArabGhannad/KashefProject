@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<main class="commerce-shell account-shell"><a class="back-link" href="/account/">← Back to your account</a><div class="account-layout"><section class="account-intro"><span class="commerce-eyebrow">ACCOUNT SECURITY</span><h1>Change password<span>.</span></h1><p>Choose a strong password you do not use on another website.</p></section><form method="post" action="/account/change-password" class="commerce-form account-form">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><label class="full" asp-for="CurrentPassword">Current password<input asp-for="CurrentPassword" autocomplete="current-password" autofocus /><span asp-validation-for="CurrentPassword"></span></label><label class="full" asp-for="NewPassword">New password<input asp-for="NewPassword" autocomplete="new-password" /><small>Use at least 12 characters with uppercase, lowercase, a number, and a symbol.</small><span asp-validation-for="NewPassword"></span></label><label class="full" asp-for="ConfirmPassword">Confirm new password<input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></label><button class="button button-dark full" type="submit">Change password <span>→</span></button></form></div></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
