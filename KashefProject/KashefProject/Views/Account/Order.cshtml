@model KashefProject.Data.StoreOrder
@{ ViewData["Title"] = $"Order {Model.Reference}"; }
<main class="commerce-shell"><a class="back-link" href="/account/">← Back to your account</a><div class="commerce-heading"><span>ORDER DETAILS</span><h1>@Model.Reference<span>.</span></h1><p>Placed @Model.CreatedUtc.ToString("MMMM d, yyyy")</p></div>
    <span class="order-status @(Model.Status == KashefProject.Data.OrderStatus.Paid ? "order-status--paid" : Model.Status == KashefProject.Data.OrderStatus.Refunded ? "order-status--refunded" : "")">@(Model.Status == KashefProject.Data.OrderStatus.Paid ? $"Paid · {Model.FulfillmentStatus}" : Model.Status == KashefProject.Data.OrderStatus.Refunded ? "Fully refunded" : Model.Status == KashefProject.Data.OrderStatus.Cancelled ? "Cancelled" : "Payment pending")</span>
    <div class="commerce-grid account-order-grid"><section><h2>Delivery</h2>@if (string.IsNullOrWhiteSpace(Model.AddressLine1)) { <p>Delivery details will be saved after secure payment.</p> } else { <address>@Model.FullName<br />@Model.AddressLine1@if (!string.IsNullOrWhiteSpace(Model.AddressLine2)) { <br />@Model.AddressLine2 }<br />@Model.City, @Model.State @Model.PostalCode<br />United States</address> }<p>@Model.Email@if (!string.IsNullOrWhiteSpace(Model.Phone)) { <br />@Model.Phone }</p>
            @if (Model.Status == KashefProject.Data.OrderStatus.Paid)
            {
                <div class="customer-shipping-card">
                    <span class="commerce-eyebrow">SHIPPING UPDATE</span>
                    <h3>@(Model.FulfillmentStatus switch { KashefProject.Data.FulfillmentStatus.Shipped => "Your order is on the way", KashefProject.Data.FulfillmentStatus.Delivered => "Your order was delivered", KashefProject.Data.FulfillmentStatus.Processing => "Your order is being prepared", _ => "Your order is confirmed" })</h3>
                    @if (!string.IsNullOrWhiteSpace(Model.TrackingNumber))
                    {
                        <dl class="customer-tracking"><div><dt>Carrier</dt><dd>@(string.IsNullOrWhiteSpace(Model.TrackingCarrier) ? "Shipping carrier" : Model.TrackingCarrier)</dd></div><div><dt>Tracking number</dt><dd>@Model.TrackingNumber</dd></div></dl>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerMessage)) { <p class="customer-message">@Model.CustomerMessage</p> }
                    @if (Model.ShippedUtc is not null) { <small>Shipped @Model.ShippedUtc.Value.ToString("MMMM d, yyyy")</small> }
                </div>
            }
            @if (Model.Status == KashefProject.Data.OrderStatus.Refunded)
            {
                <div class="customer-refund-card"><span class="commerce-eyebrow">REFUND CONFIRMED</span><h3>@StoreMoney.Format(Model.RefundedCents ?? Model.PaymentReceivedCents ?? 0) refunded</h3><p>The refund is returning to the original payment method. Your bank may take several business days to show it.</p>@if (Model.RefundedUtc is not null) { <small>Confirmed @Model.RefundedUtc.Value.ToString("MMMM d, yyyy")</small> }</div>
            }
            @if (Model.Status == KashefProject.Data.OrderStatus.PendingPayment) { <form method="post" action="/checkout/pay/@Model.Reference">@Html.AntiForgeryToken()<button class="button button-dark" type="submit">Pay securely with Stripe <span>→</span></button></form> } else if (Model.Status is KashefProject.Data.OrderStatus.Paid or KashefProject.Data.OrderStatus.Refunded) { <a class="button button-dark" href="/account/orders/@Model.Reference/invoice">Open printable invoice <span>↗</span></a> }</section>
        <aside class="commerce-summary"><span class="commerce-eyebrow">ORDER · USD</span>@foreach (var line in Model.Lines) { <div class="commerce-mini-line"><span>@line.ProductName × @line.Quantity</span><strong>@StoreMoney.Format(line.UnitPriceCents * line.Quantity)</strong></div> }<div class="commerce-mini-line"><span>Shipping</span><strong>@(Model.ShippingCents == 0 ? "Free" : Model.ShippingCents is null ? "Pending" : StoreMoney.Format(Model.ShippingCents.Value))</strong></div>@if (Model.Status is KashefProject.Data.OrderStatus.Paid or KashefProject.Data.OrderStatus.Refunded) { <div class="commerce-mini-line"><span>Tax</span><strong>@StoreMoney.Format(Model.TaxCents ?? 0)</strong></div> }<div class="summary-total"><span>@(Model.Status == KashefProject.Data.OrderStatus.Refunded ? "Total refunded" : Model.Status == KashefProject.Data.OrderStatus.Paid ? "Total paid" : "Total before tax")</span><strong>@StoreMoney.Format(Model.Status == KashefProject.Data.OrderStatus.Refunded ? Model.RefundedCents ?? Model.PaymentReceivedCents ?? 0 : Model.Status == KashefProject.Data.OrderStatus.Paid ? Model.PaymentReceivedCents ?? Model.TotalCents ?? 0 : Model.SubtotalCents + (Model.ShippingCents ?? 0))</strong></div></aside>
    </div>
</main>
