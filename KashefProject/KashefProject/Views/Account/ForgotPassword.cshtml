@model AccountEmailViewModel
@{ ViewData["Title"] = "Reset your password"; }
<main class="commerce-shell account-shell"><div class="account-layout"><section class="account-intro"><span class="commerce-eyebrow">ACCOUNT RECOVERY</span><h1>Reset your password<span>.</span></h1><p>We’ll email a secure reset link if the address belongs to an account.</p></section><form method="post" action="/account/forgot-password" class="commerce-form account-form">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><label class="full" asp-for="Email">Email address<input asp-for="Email" type="email" autocomplete="email" autofocus /><span asp-validation-for="Email"></span></label><button class="button button-dark full" type="submit">Send reset link <span>→</span></button><p class="full account-switch"><a href="/account/login">Back to sign in</a></p></form></div></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
