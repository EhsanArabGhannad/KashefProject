@model KashefProject.Data.StoreOrder
@{ Layout = null; var total = Model.PaymentReceivedCents ?? Model.TotalCents ?? (Model.SubtotalCents + (Model.ShippingCents ?? 0) + (Model.TaxCents ?? 0)); }
<!doctype html>
<html lang="en-US"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Invoice @Model.Reference | Craftisma</title>
<style>body{margin:0;background:#eeeae1;color:#181817;font-family:Arial,sans-serif}.sheet{max-width:820px;margin:40px auto;background:#fff;padding:56px;box-sizing:border-box}.top{display:flex;justify-content:space-between;gap:32px;border-bottom:2px solid #181817;padding-bottom:28px}.brand{font-size:28px;font-weight:800}.brand b{color:#ff6834}.label{font-size:12px;font-weight:800;letter-spacing:.14em;color:#676158}.meta{text-align:right}.meta h1{margin:0 0 8px;font-size:32px}.cols{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin:38px 0}.cols p,address{line-height:1.65;font-style:normal}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.13em;color:#676158}.items{width:100%;border-collapse:collapse}.items th,.items td{text-align:left;padding:16px 8px;border-bottom:1px solid #ddd}.items th:last-child,.items td:last-child{text-align:right}.totals{margin:28px 0 0 auto;width:min(100%,340px)}.totals div{display:flex;justify-content:space-between;padding:8px}.totals .grand{font-size:20px;font-weight:800;border-top:2px solid #181817;margin-top:8px;padding-top:16px}.paid{display:inline-block;background:#e3efd1;border-radius:99px;padding:9px 14px;font-weight:800}.actions{max-width:820px;margin:20px auto 48px;display:flex;gap:12px}.actions button,.actions a{border:0;border-radius:99px;padding:13px 20px;background:#181817;color:#fff;text-decoration:none;font:700 14px Arial;cursor:pointer}@@media(max-width:700px){.sheet{margin:0;padding:28px 20px}.top,.cols{display:block}.meta{text-align:left;margin-top:30px}.actions{padding:0 18px}}@@media print{body{background:#fff}.sheet{margin:0 auto;padding:30px;max-width:none}.actions{display:none}}</style></head>
<body><div class="sheet"><header class="top"><div><div class="brand">CRAFTISMA<b>.</b></div><p>craftisma.net<br />Virginia, United States</p></div><div class="meta"><h1>Invoice</h1><strong>@Model.Reference</strong><p>Issued @((Model.PaidUtc ?? Model.CreatedUtc).ToString("MMMM d, yyyy"))</p><span class="paid">PAID</span></div></header>
<section class="cols"><div><span class="eyebrow">BILLED TO</span><address><strong>@Model.FullName</strong><br />@Model.Email@if (!string.IsNullOrWhiteSpace(Model.Phone)) { <br />@Model.Phone }</address></div><div><span class="eyebrow">DELIVER TO</span><address>@Model.AddressLine1@if (!string.IsNullOrWhiteSpace(Model.AddressLine2)) { <br />@Model.AddressLine2 }<br />@Model.City, @Model.State @Model.PostalCode<br />United States</address></div></section>
<table class="items"><thead><tr><th>Item</th><th>Qty</th><th>Unit price</th><th>Amount</th></tr></thead><tbody>@foreach (var line in Model.Lines) { <tr><td><strong>@line.ProductName</strong><br /><small>@line.Finish · @line.Size</small></td><td>@line.Quantity</td><td>@StoreMoney.Format(line.UnitPriceCents)</td><td>@StoreMoney.Format(line.UnitPriceCents * line.Quantity)</td></tr> }</tbody></table>
<div class="totals"><div><span>Subtotal</span><strong>@StoreMoney.Format(Model.SubtotalCents)</strong></div><div><span>Shipping</span><strong>@StoreMoney.Format(Model.ShippingCents ?? 0)</strong></div><div><span>Tax</span><strong>@StoreMoney.Format(Model.TaxCents ?? 0)</strong></div><div class="grand"><span>Total paid</span><strong>@StoreMoney.Format(total)</strong></div></div><p style="margin-top:48px;color:#676158;font-size:12px">Payment processed securely by Stripe. This document is your Craftisma purchase receipt and invoice.</p></div>
<div class="actions"><button type="button" onclick="window.print()">Print / Save as PDF</button><a href="/account/orders/@Model.Reference">Back to order</a></div></body></html>
