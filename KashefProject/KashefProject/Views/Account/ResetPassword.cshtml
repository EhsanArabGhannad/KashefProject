@model ResetPasswordViewModel
@{ ViewData["Title"] = "Choose a new password"; }
<main class="commerce-shell account-shell"><div class="account-layout"><section class="account-intro"><span class="commerce-eyebrow">ACCOUNT RECOVERY</span><h1>Choose a new password<span>.</span></h1><p>Use a strong password that you do not reuse elsewhere.</p></section><form method="post" action="/account/reset-password" class="commerce-form account-form">@Html.AntiForgeryToken()<input asp-for="UserId" type="hidden" /><input asp-for="Code" type="hidden" /><div asp-validation-summary="All"></div><label class="full" asp-for="Password">New password<input asp-for="Password" autocomplete="new-password" autofocus /><small>Use at least 12 characters with uppercase, lowercase, a number, and a symbol.</small><span asp-validation-for="Password"></span></label><label class="full" asp-for="ConfirmPassword">Confirm new password<input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></label><button class="button button-dark full" type="submit">Save new password <span>→</span></button></form></div></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
