@model CustomerProfileViewModel
@{ ViewData["Title"] = "Your profile"; }
<main class="commerce-shell account-shell"><a class="back-link" href="/account/">← Back to your account</a><div class="account-layout"><section class="account-intro"><span class="commerce-eyebrow">ACCOUNT SETTINGS</span><h1>Your profile<span>.</span></h1><p>Your verified email is used for receipts and order updates.</p></section><form method="post" action="/account/profile" class="commerce-form account-form">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div>@if (TempData["AccountMessage"] is string message) { <p class="commerce-notice full">@message</p> }<label class="full" asp-for="FullName">Full name<input asp-for="FullName" autocomplete="name" autofocus /><span asp-validation-for="FullName"></span></label><label class="full" asp-for="Email">Verified email<input asp-for="Email" type="email" readonly /></label><button class="button button-dark full" type="submit">Save profile <span>→</span></button></form></div></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
