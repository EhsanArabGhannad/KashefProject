@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Objects unlike anyone else's";
}

<main id="top">
    <section class="hero">
        <div class="hero-copy reveal">
            <span class="eyebrow"><i></i> Made to order, never mass-produced</span>
            <h1>Objects unlike<br /><em>anyone else's.</em></h1>
            <p>Distinctive dimensional wall art, brought to life through 3D printing—one intentional layer at a time.</p>
            <div class="hero-actions">
                <a class="button button-dark" href="/shop/">Shop the collection <span>→</span></a>
                <a class="text-link" href="/gallery/">Explore the gallery <span>↗</span></a>
            </div>
            <div class="hero-proof">
                <div><strong>100%</strong><span>Made to order</span></div>
                <div><strong>12+</strong><span>Color options</span></div>
                <div><strong>7 days</strong><span>Average make time</span></div>
            </div>
        </div>

        <div class="hero-art reveal" aria-label="Golden Persian calligraphy wall panel">
            <span class="hero-orbit hero-orbit--one"></span>
            <span class="hero-orbit hero-orbit--two"></span>
            <img class="hero-product-image" src="~/images/products/collection/golden-calligraphy-03.jpg" alt="Golden Persian calligraphy wall panel in a modern interior" />
            <span class="art-label">NEW COLLECTION<br /><b>WALL ART</b></span>
            <span class="material-chip">GOLD<br />RELIEF</span>
            <span class="hero-sticker">MADE<br />LAYER BY LAYER</span>
        </div>
    </section>

    <section class="marquee" aria-label="Product highlights">
        <div>DESIGNED DIFFERENTLY <span>✦</span> PRECISION MADE <span>✦</span> YOUR COLOR, YOUR WAY <span>✦</span> SHIPPING ACROSS THE U.S. <span>✦</span> DESIGNED DIFFERENTLY <span>✦</span> PRECISION MADE <span>✦</span></div>
    </section>

    <section class="category-section" aria-labelledby="category-title">
        <div class="category-heading reveal">
            <span class="eyebrow"><i></i> Explore by category</span>
            <h2 id="category-title">Find the piece<br /><em>that feels like you.</em></h2>
        </div>
        <div class="category-grid">
            <a class="category-card category-card--wide reveal" href="/gallery/calligraphy/">
                <img src="~/images/products/collection/golden-calligraphy-03.jpg" alt="Gold Persian calligraphy wall panel" loading="lazy" />
                <span class="category-number">01</span>
                <div><small>DIMENSIONAL SCRIPT</small><h3>Calligraphy</h3><span>Explore category →</span></div>
            </a>
            <a class="category-card reveal" href="/gallery/portraits/">
                <img src="~/images/products/collection/shahbanu-portrait-01.jpg" alt="Gold Shahbanu portrait wall panel" loading="lazy" />
                <span class="category-number">02</span>
                <div><small>ICONS & FIGURES</small><h3>Portraits</h3><span>Explore category →</span></div>
            </a>
            <a class="category-card reveal" href="/gallery/heritage/">
                <img src="~/images/products/collection/lion-sun-01.jpg" alt="Gold Lion and Sun heritage wall panel" loading="lazy" />
                <span class="category-number">03</span>
                <div><small>SYMBOLS WITH A STORY</small><h3>Heritage</h3><span>Explore category →</span></div>
            </a>
        </div>
    </section>

    <section class="products-section" id="products">
        <div class="section-heading reveal">
            <div>
                <span class="eyebrow"><i></i> This week's edit</span>
                <h2>Small batch.<br /><em>Big character.</em></h2>
            </div>
            <p>Every object is made in limited quantities, with color options selected by you.</p>
        </div>

        <div class="product-grid">
            @foreach (var product in Model)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <section class="collection-feature" aria-labelledby="collection-feature-title">
        <div class="collection-feature-copy reveal">
            <span class="eyebrow eyebrow--light"><i></i> The Craftisma collection</span>
            <h2 id="collection-feature-title">A piece with<br /><em>a point of view.</em></h2>
            <p>From expressive calligraphy to familiar faces and heritage symbols, discover dimensional art with a story to tell.</p>
            <div class="collection-feature-links" aria-label="Explore the collection by category">
                <a href="/gallery/calligraphy/"><span>01</span> Calligraphy <b aria-hidden="true">↗</b></a>
                <a href="/gallery/portraits/"><span>02</span> Portraits <b aria-hidden="true">↗</b></a>
                <a href="/gallery/heritage/"><span>03</span> Heritage Symbols <b aria-hidden="true">↗</b></a>
            </div>
            <a class="button button-light" href="/shop/">Shop the collection <span>→</span></a>
        </div>

        <div class="collection-feature-preview reveal">
            <span class="preview-number">01</span>
            <span class="preview-note">ART WITH PRESENCE</span>
            <div class="collection-feature-art">
                <img src="~/images/products/collection/lion-sun-02.jpg" alt="Lion and Sun wall panel styled in a living room" loading="lazy" />
            </div>
            <div class="preview-meta">
                <span>HERITAGE SERIES</span><span>DIMENSIONAL WALL ART</span>
            </div>
        </div>
    </section>

    <section class="story-section" id="story">
        <div class="story-intro reveal">
            <span class="eyebrow"><i></i> From file to form</span>
            <h2>One idea.<br />Thousands of <em>layers.</em></h2>
        </div>
        <div class="story-body reveal">
            <p class="story-lead">Craftisma lives between digital design and hands-on craft—a place where a line on a screen slowly becomes something real for your space.</p>
            <div class="story-facts">
                <div><strong>0.2 mm</strong><span>Layer height</span></div>
                <div><strong>48 hr</strong><span>Average print time</span></div>
                <div><strong>0 excess</strong><span>Made only when ordered</span></div>
            </div>
        </div>
    </section>

    <section class="process-section" aria-label="How Craftisma pieces are made">
        <article class="process-card reveal">
            <span>01</span><h3>Choose your form</h3><p>Find a small-batch object that feels right for your space.</p>
        </article>
        <article class="process-card reveal">
            <span>02</span><h3>Place your order</h3><p>Choose a piece from the collection and leave the making to us.</p>
        </article>
        <article class="process-card reveal">
            <span>03</span><h3>We make it</h3><p>We print, finish, pack, and ship your piece directly to you.</p>
        </article>
    </section>

    <section class="final-cta reveal">
        <span class="cta-spark">✦</span>
        <p>FIND YOUR NEXT FAVORITE</p>
        <h2>Bring art into<br /><em>your space.</em></h2>
        <a class="button button-dark" href="/shop/">Explore the collection <span>→</span></a>
    </section>
</main>
