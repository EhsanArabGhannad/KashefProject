@{
    ViewData["Title"] = "Objects unlike anyone else's";
}

<main id="top">
    <section class="hero">
        <div class="hero-copy reveal">
            <span class="eyebrow"><i></i> Made to order, never mass-produced</span>
            <h1>Objects unlike<br /><em>anyone else's.</em></h1>
            <p>Distinctive decor and gifts, brought to life through 3D printing—one intentional layer at a time.</p>
            <div class="hero-actions">
                <a class="button button-dark" href="/shop/">Shop the collection <span>→</span></a>
                <a class="text-link" href="/contact/">I have an idea <span>↘</span></a>
            </div>
            <div class="hero-proof">
                <div><strong>100%</strong><span>Made to order</span></div>
                <div><strong>12+</strong><span>Color options</span></div>
                <div><strong>7 days</strong><span>Average make time</span></div>
            </div>
        </div>

        <div class="hero-art reveal" aria-label="3D-printed Wave sculpture">
            <span class="hero-orbit hero-orbit--one"></span>
            <span class="hero-orbit hero-orbit--two"></span>
            <img class="hero-product-image" src="~/images/products/wave-sculpture.png" alt="Matte black Wave sculpture with visible 3D-print texture" />
            <span class="art-label">LIMITED EDITION<br /><b>01 / 25</b></span>
            <span class="material-chip">PLA<br />MATTE</span>
            <span class="hero-sticker">MADE<br />LAYER BY LAYER</span>
        </div>
    </section>

    <section class="marquee" aria-label="Product highlights">
        <div>DESIGNED DIFFERENTLY <span>✦</span> PRECISION MADE <span>✦</span> YOUR COLOR, YOUR WAY <span>✦</span> SHIPPING ACROSS THE U.S. <span>✦</span> DESIGNED DIFFERENTLY <span>✦</span> PRECISION MADE <span>✦</span></div>
    </section>

    <section class="category-section" aria-labelledby="category-title">
        <div class="category-heading reveal">
            <span class="eyebrow"><i></i> Explore by category</span>
            <h2 id="category-title">Find the piece<br /><em>that feels like you.</em></h2>
        </div>
        <div class="category-grid">
            <a class="category-card category-card--wide reveal" href="/gallery/sculptures/">
                <img src="~/images/products/wave-sculpture.png" alt="Modern 3D-printed sculptures" loading="lazy" />
                <span class="category-number">01</span>
                <div><small>SCULPTURAL OBJECTS</small><h3>Sculptures</h3><span>Explore category →</span></div>
            </a>
            <a class="category-card reveal" href="/gallery/vases/">
                <img src="~/images/products/poly-vase.png" alt="Modern 3D-printed vases" loading="lazy" />
                <span class="category-number">02</span>
                <div><small>FUNCTIONAL FORMS</small><h3>Vases</h3><span>Explore category →</span></div>
            </a>
            <a class="category-card reveal" href="/gallery/wall-art/">
                <img src="~/images/products/gol-frame.png" alt="3D-printed wall art and relief panels" loading="lazy" />
                <span class="category-number">03</span>
                <div><small>ART FOR YOUR WALLS</small><h3>Wall Art</h3><span>Explore category →</span></div>
            </a>
        </div>
    </section>

    <section class="products-section" id="products">
        <div class="section-heading reveal">
            <div>
                <span class="eyebrow"><i></i> This week's edit</span>
                <h2>Small batch.<br /><em>Big character.</em></h2>
            </div>
            <p>Every object is made in limited quantities, with color options selected by you.</p>
        </div>

        <div class="product-grid">
            @foreach (var product in StoreCatalog.Products)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <section class="custom-section" id="custom">
        <div class="custom-copy reveal">
            <span class="eyebrow eyebrow--light"><i></i> Made for you</span>
            <h2>Pick the color.<br /><em>We'll make the object.</em></h2>
            <p>Start with one of our forms, then make it yours with a custom color, size, or personal detail.</p>
            <div class="option-group">
                <span>CHOOSE A COLOR</span>
                <div class="swatches" aria-label="Choose a product color">
                    <button class="swatch is-active" type="button" data-color="#c9ff3d" style="--swatch:#c9ff3d" aria-label="Acid lime"></button>
                    <button class="swatch" type="button" data-color="#ff6b35" style="--swatch:#ff6b35" aria-label="Coral orange"></button>
                    <button class="swatch" type="button" data-color="#c7b8ff" style="--swatch:#c7b8ff" aria-label="Soft lavender"></button>
                    <button class="swatch" type="button" data-color="#f1eadb" style="--swatch:#f1eadb" aria-label="Warm ivory"></button>
                </div>
            </div>
            <a class="button button-light" href="/contact/">Start a custom order <span>→</span></a>
        </div>

        <div class="custom-preview reveal" style="--piece-color:#c9ff3d">
            <span class="preview-number">01</span>
            <span class="preview-note">COLOR PREVIEW</span>
            <div class="custom-vase" aria-label="3D-printed vase color preview">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="preview-meta">
                <span>FORM: RHYTHM</span><span>SIZE: MEDIUM</span><span>MATERIAL: PLA+</span>
            </div>
        </div>
    </section>

    <section class="story-section" id="story">
        <div class="story-intro reveal">
            <span class="eyebrow"><i></i> From file to form</span>
            <h2>One idea.<br />Thousands of <em>layers.</em></h2>
        </div>
        <div class="story-body reveal">
            <p class="story-lead">Craftisma lives between digital design and hands-on craft—a place where a line on a screen slowly becomes something real for your space.</p>
            <div class="story-facts">
                <div><strong>0.2 mm</strong><span>Layer height</span></div>
                <div><strong>48 hr</strong><span>Average print time</span></div>
                <div><strong>0 excess</strong><span>Made only when ordered</span></div>
            </div>
        </div>
    </section>

    <section class="process-section" aria-label="How custom orders work">
        <article class="process-card reveal">
            <span>01</span><h3>Choose your form</h3><p>Find a small-batch object that feels right for your space.</p>
        </article>
        <article class="process-card reveal">
            <span>02</span><h3>Make it yours</h3><p>Select the color, size, and details that bring your idea to life.</p>
        </article>
        <article class="process-card reveal">
            <span>03</span><h3>We make it</h3><p>We print, finish, pack, and ship your piece directly to you.</p>
        </article>
    </section>

    <section class="final-cta reveal">
        <span class="cta-spark">✦</span>
        <p>HAVE SOMETHING IN MIND?</p>
        <h2>Bring it into<br /><em>the real world.</em></h2>
        <a class="button button-dark" href="/contact/">Start a custom order <span>→</span></a>
    </section>
</main>
