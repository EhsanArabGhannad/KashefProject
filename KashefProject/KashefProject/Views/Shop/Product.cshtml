@model Product
@{
    ViewData["Title"] = Model.Name;
    ViewData["Description"] = Model.Description;
    ViewData["OgImage"] = $"https://ehsanarabghannad.github.io/KashefProject{Model.ImagePath}";
}

<main>
    <section class="product-detail">
        <div class="product-gallery reveal" data-product-gallery>
            <div class="product-main-image @Model.CardClass" data-gallery-main>
                <img src="@Model.ImagePath" alt="@Model.ImageAlt" data-gallery-main-image />
                <span class="product-image-label" data-view-label>VIEW 01</span>
                <span class="gallery-hint">Select a view below</span>
            </div>
            <div class="product-thumbnails" aria-label="Product image views">
                @for (var index = 0; index < Model.Images.Count; index++)
                {
                    var image = Model.Images[index];
                    <button class="@(index == 0 ? "is-active" : null)" type="button" data-gallery-image="@image" data-gallery-label="VIEW @((index + 1).ToString("00"))" aria-label="Show @Model.Name view @(index + 1)">
                        <img src="@image" alt="" />
                    </button>
                }
            </div>
        </div>

        <div class="product-detail-copy reveal">
            <a class="back-link" href="/shop/">← Back to shop</a>
            <span class="product-detail-category">@Model.CategoryName / @Model.Badge</span>
            <h1>@Model.Name</h1>
            <strong class="product-detail-price">@Model.Price</strong>
            <p class="product-detail-description">@Model.Description</p>

            <div class="product-options">
                <div class="product-finish-note">
                    <span>SELECT A FINISH</span>
                    <div class="swatches swatches--light" aria-label="Choose a product color">
                        <button class="swatch is-active" type="button" data-color-name="Classic gold" style="--swatch:#c78b18" aria-label="Classic gold"></button>
                        <button class="swatch" type="button" data-color-name="Antique gold" style="--swatch:#8e6b32" aria-label="Antique gold"></button>
                        <button class="swatch" type="button" data-color-name="Warm ivory" style="--swatch:#eee6d7" aria-label="Warm ivory"></button>
                        <button class="swatch" type="button" data-color-name="Charcoal" style="--swatch:#2b2a27" aria-label="Charcoal"></button>
                    </div>
                    <small data-selected-color>Classic gold</small>
                </div>
            </div>

            <button class="button button-dark product-add" type="button" data-add="@Model.Name" data-price="@Model.Price">Add to bag <span>→</span></button>

            <dl class="product-specs">
                <div><dt>Size</dt><dd>@Model.Size</dd></div>
                <div><dt>Material</dt><dd>@Model.Material</dd></div>
                <div><dt>Finish</dt><dd>@Model.Finish</dd></div>
            </dl>
            <ul class="product-highlights">
                @foreach (var highlight in Model.Highlights)
                {
                    <li>@highlight</li>
                }
            </ul>
        </div>
    </section>

    <section class="detail-story reveal">
        <span>MADE ONE LAYER AT A TIME</span>
        <h2>A digital form,<br /><em>finished by hand.</em></h2>
        <p>Small variations in the printed texture are part of the process—each one is a subtle record of how your piece was made.</p>
    </section>
</main>
