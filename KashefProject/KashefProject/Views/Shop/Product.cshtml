@model ProductDetailViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    ViewData["Description"] = product.Description;
    var publicUrl = Configuration["Site:PublicUrl"]?.TrimEnd('/') ?? "https://craftisma.net";
    ViewData["OgImage"] = $"{publicUrl}{product.ImagePath}";
}

<main>
    <section class="product-detail">
        <div class="product-gallery reveal" data-product-gallery>
            <div class="product-main-image @product.CardClass" data-gallery-main>
                <img src="@product.ImagePath" alt="@product.ImageAlt" data-gallery-main-image />
                <span class="product-image-label" data-view-label>VIEW 01</span>
                <span class="gallery-hint">Select a view below</span>
            </div>
            <div class="product-thumbnails" aria-label="Product image views">
                @for (var index = 0; index < product.Images.Count; index++)
                {
                    var image = product.Images[index];
                    <button class="@(index == 0 ? "is-active" : null)" type="button" data-gallery-image data-gallery-label="VIEW @((index + 1).ToString("00"))" aria-label="Show @product.Name view @(index + 1)" aria-pressed="@(index == 0 ? "true" : "false")">
                        <img src="@image" alt="" />
                    </button>
                }
            </div>
        </div>

        <div class="product-detail-copy reveal">
            <a class="back-link" href="/shop/">← Back to shop</a>
            <span class="product-detail-category">@product.CategoryName / @product.Badge</span>
            <h1>@product.Name</h1>
            <strong class="product-detail-price">@product.Price</strong>
            <p class="product-detail-description">@product.Description</p>

            <div class="product-options">
                <div class="product-finish-note">
                    <span>FINISH</span>
                    <span>@product.Finish</span>
                </div>
            </div>

            @if (product.PriceCents > 0)
            {
                <form class="product-buy-form" method="post" action="/cart/add" data-submit-once>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button class="button button-dark product-add" type="submit" data-pending-label="Adding to bag…">Add to bag <span>→</span></button>
                </form>
            }
            else
            {
                <a class="button button-dark product-add" href="/contact/">Request pricing <span>→</span></a>
            }

            <dl class="product-specs">
                <div><dt>Size</dt><dd>@product.Size</dd></div>
                <div><dt>Material</dt><dd>@product.Material</dd></div>
                <div><dt>Finish</dt><dd>@product.Finish</dd></div>
            </dl>
            <ul class="product-highlights">
                @foreach (var highlight in product.Highlights)
                {
                    <li>@highlight</li>
                }
            </ul>
        </div>
    </section>

    @if (Model.RelatedProducts.Count > 0)
    {
        <section class="related-products" aria-labelledby="related-products-title">
            <div class="related-products-heading reveal">
                <div>
                    <span class="eyebrow"><i></i> Explore more</span>
                    <h2 id="related-products-title">You might also <em>love.</em></h2>
                </div>
                <a class="text-link" href="/shop/">View all pieces <span>↗</span></a>
            </div>
            <div class="product-grid product-grid--related">
                @foreach (var relatedProduct in Model.RelatedProducts)
                {
                    <partial name="_ProductCard" model="relatedProduct" />
                }
            </div>
        </section>
    }
</main>
