@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Shop";
    ViewData["Description"] = "Shop Craftisma's small-batch 3D-printed decor, wall art, sculptures, and made-to-order gifts.";
}

<main>
    <section class="page-hero page-hero--shop">
        <div class="page-hero-copy reveal">
            <span class="eyebrow"><i></i> The complete collection</span>
            <h1>Objects with<br /><em>their own point of view.</em></h1>
            <p>Small-batch pieces, printed to order and available in the color that works for your space.</p>
        </div>
        <div class="shop-hero-orbit" aria-hidden="true"><span>3</span><small>PIECES<br />AVAILABLE</small></div>
    </section>

    <section class="shop-toolbar" aria-label="Shop categories">
        <span>SHOP ALL</span>
        <a href="/gallery/sculptures/">Sculptures</a>
        <a href="/gallery/vases/">Vases</a>
        <a href="/gallery/wall-art/">Wall Art</a>
    </section>

    <section class="shop-products">
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <section class="shop-custom reveal">
        <span class="eyebrow eyebrow--light"><i></i> Need another color or size?</span>
        <h2>Make one<br /><em>entirely yours.</em></h2>
        <a class="button button-light" href="/contact/">Start a custom order <span>→</span></a>
    </section>
</main>
