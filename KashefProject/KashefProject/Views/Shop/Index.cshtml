@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Shop";
    ViewData["Description"] = "Shop Craftisma's dimensional calligraphy, portrait, and heritage wall panels, made to order.";
}

<main>
    <section class="page-hero page-hero--shop">
        <div class="page-hero-copy reveal">
            <span class="eyebrow"><i></i> The complete collection</span>
            <h1>Objects with<br /><em>their own point of view.</em></h1>
            <p>Small-batch pieces, printed to order and available in the color that works for your space.</p>
        </div>
        <div class="shop-hero-orbit" aria-hidden="true"><span>@Model.Count</span><small>PIECES<br />AVAILABLE</small></div>
    </section>

    <section class="shop-toolbar" aria-label="Shop categories">
        <span>SHOP ALL</span>
        <a href="/gallery/calligraphy/">Calligraphy</a>
        <a href="/gallery/portraits/">Portraits</a>
        <a href="/gallery/heritage/">Heritage Symbols</a>
    </section>

    <section class="shop-products">
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <section class="shop-custom reveal">
        <span class="eyebrow eyebrow--light"><i></i> Explore the stories behind the art</span>
        <h2>More than<br /><em>a wall piece.</em></h2>
        <a class="button button-light" href="/gallery/">Visit the gallery <span>→</span></a>
    </section>
</main>
