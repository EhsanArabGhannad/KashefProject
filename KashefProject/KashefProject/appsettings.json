{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Site": {
    "PublicUrl": "https://craftisma.net"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/craftisma.db"
  },
  "Storage": {
    "UploadRoot": "App_Data/uploads",
    "DataProtectionRoot": "App_Data/keys"
  },
  "Fulfillment": {
    "OriginState": "VA",
    "StandardShippingCents": 1500,
    "FreeShippingThresholdCents": 15000,
    "AutomaticTaxEnabled": true
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "AllowedHosts": "*"
}
