@model ProductEditorViewModel
@{
    var isEditing = Model.Id > 0;
    ViewData["Title"] = isEditing ? $"Edit {Model.Name}" : "Add product";
    var action = isEditing ? $"/admin/products/{Model.Id}/edit" : "/admin/products/create";
}

<div class="editor-heading">
    <a href="/admin/products">← Back to products</a>
    <span class="admin-eyebrow">@(isEditing ? "EDIT PRODUCT" : "NEW PRODUCT")</span>
    <h1>@(isEditing ? Model.Name : "Add a new piece")</h1>
</div>

<form method="post" action="@action" enctype="multipart/form-data" class="product-editor">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <section class="editor-card editor-grid">
        <h2>Basic information</h2>
        <label><span>Product name</span><input asp-for="Name" /><small asp-validation-for="Name"></small></label>
        <label><span>URL slug</span><input asp-for="Slug" placeholder="generated-from-product-name" /><small asp-validation-for="Slug"></small></label>
        <label><span>Category</span><select asp-for="CategoryId" asp-items="Model.Categories"><option value="">Choose a category</option></select><small asp-validation-for="CategoryId"></small></label>
        <label><span>Price (USD)</span><input asp-for="PriceDollars" type="number" min="0.01" step="0.01" placeholder="Leave empty until price is ready" /><small asp-validation-for="PriceDollars"></small></label>
        <label class="full"><span>Short description</span><input asp-for="ShortDescription" /><small asp-validation-for="ShortDescription"></small></label>
        <label class="full"><span>Full description</span><textarea asp-for="Description" rows="5"></textarea><small asp-validation-for="Description"></small></label>
    </section>

    <section class="editor-card editor-grid">
        <h2>Details</h2>
        <label><span>Size</span><input asp-for="Size" /><small asp-validation-for="Size"></small></label>
        <label><span>Material</span><input asp-for="Material" /><small asp-validation-for="Material"></small></label>
        <label><span>Finish</span><input asp-for="Finish" /><small asp-validation-for="Finish"></small></label>
        <label><span>Badge</span><input asp-for="Badge" /><small asp-validation-for="Badge"></small></label>
        <label><span>Card color</span><select asp-for="CardClass"><option value="product-card--cream">Cream</option><option value="product-card--lavender">Lavender</option><option value="product-card--orange">Orange</option></select></label>
        <label><span>Display order</span><input asp-for="DisplayOrder" type="number" min="0" /></label>
        <label class="full"><span>Highlights (one per line)</span><textarea asp-for="HighlightsText" rows="4"></textarea><small asp-validation-for="HighlightsText"></small></label>
        <label class="check-row"><input asp-for="IsFeatured" /> <span>Featured on home page</span></label>
        <label class="check-row"><input asp-for="IsPublished" /> <span>Visible in the store</span></label>
    </section>

    <section class="editor-card">
        <h2>Product images</h2>
        @if (Model.ExistingImages.Count > 0)
        {
            <div class="existing-images">
                @foreach (var image in Model.ExistingImages)
                {
                    <label>
                        <img src="@image.ImagePath" alt="@image.AltText" />
                        <span><input type="checkbox" name="RemoveImageIds" value="@image.Id" /> Remove</span>
                    </label>
                }
            </div>
        }
        <label class="upload-field"><span>Upload JPG, PNG, or WebP images (up to 8 MB each)</span><input asp-for="NewImages" type="file" accept="image/jpeg,image/png,image/webp" multiple /><small asp-validation-for="NewImages"></small></label>
    </section>

    <div class="editor-actions">
        <a href="/admin/products">Cancel</a>
        <button class="admin-primary" type="submit">@(isEditing ? "Save changes" : "Add product") <span>→</span></button>
    </div>
</form>
