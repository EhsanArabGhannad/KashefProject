@model IReadOnlyList<CalendarEvent>
@using KashefProject.Models
@{
    ViewData["Title"] = "Calendar events";
}
<div class="admin-page-heading">
    <div><span class="admin-eyebrow">HERITAGE CALENDAR</span><h1>Calendar events</h1><p>Manage occasions, both languages and faded day-card images.</p></div>
    <a class="admin-primary" href="/admin/calendar-events/create">Add event <span>＋</span></a>
</div>
@if (TempData["StatusMessage"] is string message) { <div class="admin-notice" role="status">@message</div> }
<p class="subtle-copy">@Model.Count events · Changes appear on the calendar immediately after saving. <a href="/calendar/" target="_blank" rel="noopener">View calendar ↗</a></p>
@if (Model.Count == 0) { <div class="editor-card">No events yet. Add your first occasion above.</div> }
<div class="product-admin-list">
@foreach (var item in Model)
{
    <article class="product-admin-row calendar-admin-row">
        <div class="product-admin-image">@if (item.ImagePath is not null) { <img src="@item.ImagePath" alt="" loading="lazy" /> }</div>
        <div class="product-admin-copy"><div><h2>@item.TitleEn</h2><p lang="fa" dir="rtl">@item.TitleFa</p><span>@item.Rule · @item.Month / @item.Day · @(item.OnlyImperialYear.HasValue ? $"Imperial {item.OnlyImperialYear}" : "Every year")</span></div></div>
        <div class="product-admin-state"><span class="@(item.IsPublished ? "state-live" : "state-hidden")">@(item.IsPublished ? "Live" : "Hidden")</span><span>@HeritageCalendarText.Category(item.Category, "en")</span></div>
        <div class="product-admin-actions"><a class="edit" href="/admin/calendar-events/@item.Id/edit">Edit</a><a href="/admin/calendar-events/@item.Id/delete">Delete</a></div>
    </article>
}
</div>
