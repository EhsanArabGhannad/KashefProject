@model StoreOrder
@{ ViewData["Title"] = Model.Reference; }

<div class="editor-heading">
    <a href="/admin/orders">← All orders</a>
    <h1>@Model.Reference</h1>
    <p>@Model.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @(Model.Status switch { OrderStatus.Paid => "Paid", OrderStatus.Cancelled => "Cancelled", _ => "Pending payment" })</p>
</div>

@if (TempData["OrderNotice"] is string notice) { <p class="admin-notice">@notice</p> }

<div class="order-detail-grid">
    <section class="editor-card order-payment-card">
        @if (Model.Status == OrderStatus.Paid)
        {
            <span class="status-pill status-pill--paid">Payment verified</span>
            <h2>Total paid</h2>
            <strong class="order-total">@KashefProject.Models.StoreMoney.Format(Model.PaymentReceivedCents ?? Model.SubtotalCents)</strong>
            <dl class="order-totals">
                <div><dt>Items</dt><dd>@KashefProject.Models.StoreMoney.Format(Model.SubtotalCents)</dd></div>
                <div><dt>Shipping</dt><dd>@KashefProject.Models.StoreMoney.Format(Model.ShippingCents ?? 0)</dd></div>
                <div><dt>Tax</dt><dd>@KashefProject.Models.StoreMoney.Format(Model.TaxCents ?? 0)</dd></div>
            </dl>
            <small>Stripe confirmed payment @Model.PaidUtc?.ToString("MMM d, yyyy · HH:mm") UTC</small>
        }
        else
        {
            <span class="status-pill status-pill--@Model.Status.ToString().ToLowerInvariant()">@(Model.Status == OrderStatus.Cancelled ? "Cancelled" : "Pending payment")</span>
            <h2>Payment not received</h2>
            <p>Do not fulfill this order until Stripe confirms payment.</p>
            <strong class="order-total">@KashefProject.Models.StoreMoney.Format(Model.SubtotalCents + (Model.ShippingCents ?? 0))</strong>
            <small>Total before tax</small>
        }
    </section>

    <section class="editor-card">
        <h2>Customer & delivery</h2>
        <p><strong>@Model.FullName</strong><br /><a href="mailto:@Model.Email">@Model.Email</a>@if (!string.IsNullOrWhiteSpace(Model.Phone)) { <br />@Model.Phone }</p>
        @if (string.IsNullOrWhiteSpace(Model.AddressLine1))
        {
            <p class="subtle-copy">Delivery address will be added after Stripe confirms payment.</p>
        }
        else
        {
            <address>@Model.AddressLine1<br />@if (!string.IsNullOrWhiteSpace(Model.AddressLine2)) { @Model.AddressLine2<br /> }@Model.City, @Model.State @Model.PostalCode<br />United States</address>
        }
    </section>
</div>

@if (Model.Status == OrderStatus.Paid)
{
    <section class="editor-card fulfillment-card">
        <div class="fulfillment-heading">
            <div><span class="admin-eyebrow">FULFILLMENT</span><h2>Shipping progress</h2></div>
            <span class="status-pill status-pill--@Model.FulfillmentStatus.ToString().ToLowerInvariant()">@Model.FulfillmentStatus</span>
        </div>
        <form class="editor-grid" method="post" action="/admin/orders/@Model.Id/fulfillment">
            @Html.AntiForgeryToken()
            <label>Status
                <select name="FulfillmentStatus">
                    @foreach (var status in Enum.GetValues<FulfillmentStatus>())
                    {
                        <option value="@status" selected="@(status == Model.FulfillmentStatus)">@status</option>
                    }
                </select>
            </label>
            <label>Shipping carrier<input name="TrackingCarrier" maxlength="80" value="@Model.TrackingCarrier" placeholder="USPS, UPS, FedEx…" /></label>
            <label class="full">Tracking number<input name="TrackingNumber" maxlength="120" value="@Model.TrackingNumber" placeholder="Required when marked Shipped" /></label>
            <label class="full">Private order notes<textarea name="AdminNotes" maxlength="1000" rows="4" placeholder="Production details, packing notes, customer request…">@Model.AdminNotes</textarea></label>
            <div class="full fulfillment-meta">
                @if (Model.ShippedUtc is not null) { <span>Shipped @Model.ShippedUtc.Value.ToString("MMM d, yyyy · HH:mm") UTC</span> }
                @if (Model.DeliveredUtc is not null) { <span>Delivered @Model.DeliveredUtc.Value.ToString("MMM d, yyyy · HH:mm") UTC</span> }
            </div>
            <div class="editor-actions full"><button class="admin-primary" type="submit">Save fulfillment</button></div>
        </form>
    </section>

    <section class="editor-card notification-card">
        <div class="fulfillment-heading">
            <div><span class="admin-eyebrow">AUTOMATIC EMAILS</span><h2>Delivery log</h2></div>
            @if (Model.Notifications.Any(notification => notification.Status == OrderNotificationStatus.Failed))
            {
                <form method="post" action="/admin/orders/@Model.Id/notifications/retry">
                    @Html.AntiForgeryToken()
                    <button class="admin-secondary" type="submit">Retry failed email</button>
                </form>
            }
        </div>
        @if (Model.Notifications.Count == 0)
        {
            <p class="subtle-copy">No automatic emails were queued for this older order.</p>
        }
        else
        {
            <div class="notification-list">
            @foreach (var notification in Model.Notifications.OrderBy(item => item.Id))
            {
                var label = notification.Kind switch
                {
                    OrderNotificationKind.PaymentCustomer => "Order confirmation · customer",
                    OrderNotificationKind.PaymentAdmin => "New order alert · admin",
                    _ => "Shipping confirmation · customer"
                };
                <div class="notification-row">
                    <div><strong>@label</strong><small>@(notification.SentUtc is null ? $"Queued {notification.CreatedUtc:MMM d, yyyy · HH:mm} UTC" : $"Sent {notification.SentUtc:MMM d, yyyy · HH:mm} UTC")</small></div>
                    <span class="status-pill status-pill--@notification.Status.ToString().ToLowerInvariant()">@notification.Status</span>
                </div>
            }
            </div>
        }
    </section>
}

<section class="editor-card order-lines-card">
    <h2>Ordered pieces</h2>
    <p class="subtle-copy">These details are saved with the order and do not change when products are edited.</p>
    @foreach (var line in Model.Lines)
    {
        <article class="order-line"><div><h3>@line.ProductName</h3><p>@line.Size · @line.Finish</p></div><strong>@line.Quantity × @KashefProject.Models.StoreMoney.Format(line.UnitPriceCents)</strong><span>@KashefProject.Models.StoreMoney.Format(line.Quantity * line.UnitPriceCents)</span></article>
    }
</section>

@if (Model.Status == OrderStatus.PendingPayment)
{
    <div class="order-actions">
        <form method="post" action="/admin/orders/@Model.Id/sync-payment">@Html.AntiForgeryToken()<button class="admin-primary" type="submit">Check Stripe payment</button></form>
        <form method="post" action="/admin/orders/@Model.Id/cancel" onsubmit="return confirm('Cancel this unpaid order?');">@Html.AntiForgeryToken()<button class="admin-secondary" type="submit">Cancel unpaid order</button></form>
    </div>
}
