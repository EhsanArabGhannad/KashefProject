@model IReadOnlyList<StoreOrder>
@{ ViewData["Title"] = "Orders"; var page = (int)ViewData["Page"]!; }
<div class="admin-page-heading"><div><span class="admin-eyebrow">STORE ORDERS</span><h1>Orders</h1><p>Saved orders are unpaid. Do not start production or shipping until payment is verified.</p></div></div>
@if (Model.Count == 0) { <section class="editor-card"><h2>No orders yet</h2><p>Orders saved at checkout will appear here.</p></section> }
@foreach (var order in Model)
{
    <article class="editor-card"><a href="/admin/orders/@order.Id"><h2>@order.Reference</h2></a><p>@order.FullName · @order.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</p><p>@(order.Status == OrderStatus.Cancelled ? "Cancelled" : "Pending payment") · Item subtotal @KashefProject.Models.StoreMoney.Format(order.SubtotalCents)</p><a href="/admin/orders/@order.Id">View order →</a></article>
}
<nav aria-label="Order pages" class="editor-actions">@if (page > 1) { <a href="/admin/orders?page=@(page - 1)">← Previous</a> } @if ((bool)ViewData["HasNext"]!) { <a href="/admin/orders?page=@(page + 1)">Next →</a> }</nav>
